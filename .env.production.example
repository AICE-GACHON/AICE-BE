# 배포용 환경변수 템플릿. 서버에서 이 파일을 `.env.production`으로 복사해 채운다.
# docker-compose.prod.yml의 `env_file`이 이걸 읽어 컨테이너 환경으로 넣는다.
#
# 🔴 `.env.production`은 절대 커밋하지 않는다 (.gitignore가 `.env.*`를 막는다).
#    한 번 올라가면 히스토리에서 지워도 유출은 되돌릴 수 없다 — JWT 시크릿,
#    RDS 비밀번호, ANTHROPIC_API_KEY를 **전부 새로 발급**해야 한다.
#
# ⚠️ app/core/config.py는 `extra="ignore"`다. **오타 난 키나 아직 구현되지 않은
#    키는 조용히 무시된다** — "설정했는데 왜 안 먹지"의 대부분이 이것이다.

# ---------------------------------------------------------------- 실행 환경
# production이면 아래 값들이 기동 시점에 검사되고, 하나라도 어긋나면 서버가
# 뜨지 않는다 (경고 로그가 아니라 기동 거부다 — README "배포 전 점검").
ENVIRONMENT=production

# ---------------------------------------------------------------- DB (RDS)
# ⚠️ `?sslmode=require`를 빼지 말 것. RDS는 TLS를 요구한다.
# ⚠️ 비밀번호에 @ : / ? # 가 있으면 URL 인코딩이 필요하다 — 영숫자로만 만들 것.
DATABASE_URL=postgresql://paper:<비밀번호>@<RDS엔드포인트>:5432/paper_assistant?sslmode=require

# ---------------------------------------------------------------- 인증(JWT)
# 🔴 반드시 새로 생성한다. 개발용 값을 그대로 쓰면 공격자가 임의 user_id로
#    access_token을 위조해 아무 계정으로나 로그인할 수 있고, 서버는 그것을
#    정상 로그인과 구분할 방법이 없다.
#
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 구글 로그인. 프론트(AICE-FE)의 VITE_GOOGLE_CLIENT_ID와 **같은 값**이어야 한다 —
# 백엔드가 이 값을 id_token의 audience로 검증하므로 다르면 무조건 401이다.
# Google Cloud Console에서 승인된 JavaScript 원본에 https://paperaireview.com 등록 필요.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- 도메인/프록시
# production에서 localhost·http://·"*"가 하나라도 있으면 기동을 거부한다.
CORS_ORIGINS=["https://paperaireview.com"]

# 🔴 "localhost"를 빼지 말 것. Docker HEALTHCHECK가 127.0.0.1로 접속하면서
#    Host: localhost를 붙이는데(Dockerfile의 HEALTHCHECK_HOST), 이 목록에 없으면
#    TrustedHostMiddleware가 400으로 막아 **컨테이너가 영원히 unhealthy**가 된다.
#    그 상태는 배포 자동화가 멀쩡한 컨테이너를 죽이는 조건이다.
#    바깥에서 Host: localhost로 들어올 수는 없다 — Caddy가 도메인으로만 라우팅한다.
ALLOWED_HOSTS=["paperaireview.com","localhost"]

# Caddy 뒤에 두므로 1. 안 켜면 모든 요청 IP가 Caddy 주소로 보여서 IP 기준 상한이
# **서비스 전체 상한**이 된다 (로그인 30/hour가 전 사용자 합쳐 시간당 30회).
# 반대로 프록시가 없는데 켜면 클라이언트가 X-Forwarded-For를 지어내 상한을 우회한다.
TRUST_PROXY_HEADERS=1

# Swagger/ReDoc/OpenAPI 노출 여부. production이면 이 줄이 없어도 자동으로 닫히지만,
# 의도임을 드러내기 위해 명시한다 (스키마는 전체 엔드포인트를 알려주는 공격 지도다).
ENABLE_DOCS=0

# 요청 본문 상한(bytes). 기본 24MB. Caddyfile은 일부러 32MB로 조금 위에 둬서,
# 경계 근처 요청이 앱까지 도달해 **앱이 만든 JSON 413**을 받게 한다.
# MAX_REQUEST_BYTES=25165824

# ---------------------------------------------------------------- 기동
# 1이면 기동 시 SPECTER2를 미리 로드한다. 배포 환경에서는 켠다 — 첫 사용자가
# 수십 초를 기다리는 대신 기동이 그만큼 느려진다. 이 때문에 Dockerfile의
# HEALTHCHECK start-period가 240초다.
WARMUP_ON_STARTUP=1

# ---------------------------------------------------------------- 분석(LLM)
# 1이면 실제 LLM 호출. 분석 1회 약 $0.30이고 **AWS 크레딧과 무관하게**
# Anthropic에서 따로 청구된다. Anthropic 콘솔에도 예산 알림을 걸어둘 것.
PAPER_ASSISTANT_USE_LLM=1
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- 초대 게이트
# 🔴 **반드시 채운다.** 비어 있으면 가입이 누구에게나 열리고, 위에서 LLM을 켰으므로
#    아무나 계정을 만들어 분석(1회 약 $0.30)을 우리 카드로 돌릴 수 있다.
#    실제로 그 조합(production + USE_LLM=1 + 빈 코드)이면 **서버가 뜨지 않는다.**
#
#    이메일 가입과 구글 신규 가입 **양쪽** 모두 이 코드를 요구한다. 이미 가입한
#    사람이 로그인할 때는 요구하지 않는다.
#
#      python -c "import secrets; print(secrets.token_urlsafe(12))"
SIGNUP_INVITE_CODE=

# rate limit 저장소. 비우면 프로세스 메모리다. --workers 1로 고정해 두었으므로
# 지금은 필요 없다. 워커를 늘릴 거면 이것이 **먼저** 와야 한다.
# RATE_LIMIT_STORAGE_URI=redis://호스트:6379

# ---------------------------------------------------------------- 메일(SMTP)
# 비밀번호 재설정 메일. 비워두면 production에서 /api/auth/password/forgot이
# 503을 돌려준다(app/core/mail.py) — 서버는 정상 기동한다.
#
# 🔴 **`MAIL_FROM`이 아니라 `SMTP_FROM`이다.** config.py는 extra="ignore"라
#    이름을 틀리면 **아무 말 없이 무시되고** SMTP_FROM이 빈 채로 남는다.
#    그러면 SMTP를 전부 채워두고도 발송 조건(HOST와 FROM 둘 다)이 불성립이라
#    재설정 메일이 한 통도 나가지 않는다. 실제로 밟을 뻔한 함정이다.
#
# SMTP_USER/PASSWORD는 **SES SMTP 자격증명**이다 — IAM 액세스 키와 다른 값이다.
# SMTP_FROM은 SES에서 **검증한 주소**여야 한다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 재설정 링크의 앞부분. 서버는 프론트가 어디 있는지 모른다.
#   {FRONTEND_BASE_URL}/reset-password?token=...
# 끝 슬래시는 있어도 없어도 된다 (build_reset_url이 rstrip한다).
FRONTEND_BASE_URL=

# ---------------------------------------------------------------- OpenReview
# 🔴 **비워두면 "심사 과정 보기"가 500이 된다.** 예전 주석은 "코퍼스 재수집에만
#    필요하다"고 적혀 있었는데 틀린 설명이었고, 그대로 믿고 비워둔 채 배포해서
#    실제로 500을 봤다 (GET /api/papers/{id}/story).
#
#    수집 배치만 쓰는 것이 아니라 **런타임에 쓴다** — 심사 이력 타임라인은
#    캐시가 아니라 요청 시점에 OpenReview API에서 가져온다
#    (paper_assistant/query/story.py의 _fetch_timeline).
#
#    지금은 없어도 페이지가 죽지는 않는다(조회 실패 안내로 대체된다). 하지만
#    그 기능은 계속 비어 보인다.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# 코퍼스 재수집에만 쓴다. 서버 운영에는 비워둬도 된다.
# S2_API_KEY=
