# PostgreSQL 연결 정보 (본인 환경에 맞게 수정하세요)
DATABASE_URL=postgresql://username:password@localhost:5432/aice_db

# JWT 설정
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CODEF API (나중에 발급받으면 채우기)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=

# Kakao API
KAKAO_REST_API_KEY=
