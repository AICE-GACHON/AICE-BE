# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env는 git에 커밋 금지)
#
# 키 이름과 기본값의 정의는 paper_assistant/config.py(공유 값)와
# app/core/config.py(백엔드 전용) 두 곳뿐입니다.

# ---------------------------------------------------------------- DB
# 백엔드(app/)와 AI 파트(paper_assistant/)가 **같은 DB 하나**를 씁니다.
# 반드시 docker compose가 띄우는 pgvector 인스턴스(5433)를 가리켜야 합니다 —
# 일반 PostgreSQL(5432)에는 vector 확장도, 논문 코퍼스 43,515편도 없습니다.
DATABASE_URL=postgresql://paper:paper@localhost:5433/paper_assistant

# ---------------------------------------------------------------- 실행 환경
# development | production. production으로 두면 app/core/config.py가 개발용
# 기본값(localhost CORS, ALLOWED_HOSTS=*, 열린 /docs)을 **기동 실패로** 걸러냅니다.
# 배포 전에 반드시 production으로 바꾸세요.
ENVIRONMENT=development

# ---------------------------------------------------------------- 인증(JWT)
# ⚠️ 아래 예시 값 그대로는 서버가 뜨지 않습니다(의도된 동작입니다). 이 문자열은
#    공개 저장소에 적혀 있어서, 그대로 배포하면 누구나 임의의 user_id로
#    access_token을 위조해 아무 계정으로나 로그인할 수 있습니다. 새 값 생성:
#
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#
#    32자 미만도 거부됩니다.
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Google 로그인 — Google Cloud Console(APIs & Services > Credentials)에서
# OAuth 2.0 클라이언트 ID(웹 애플리케이션)를 만들고 여기 채워야 POST /api/auth/google이
# 동작합니다. 비어 있으면 항상 401을 반환합니다.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- 백엔드 기타
# CORS 허용 프론트엔드 origin (JSON 배열 형식). 비워두면 코드 기본값
# (localhost:3000, 5173, 5174, 5175 — 뒤 둘은 vite 포트 충돌 시 자동 대체 포트) 사용.
# ⚠️ ENVIRONMENT=production이면 localhost·http://·"*"가 하나라도 있으면 기동을 거부합니다.
# CORS_ORIGINS=["https://pair.example.com"]

# Host 헤더 허용 목록 (JSON 배열). 기본 ["*"]는 개발용입니다 — Host를 그대로 믿으면
# 캐시 오염·링크 위조의 발판이 됩니다. production에서는 "*"면 기동을 거부합니다.
# ALLOWED_HOSTS=["api.example.com"]

# Swagger(/docs)·ReDoc·OpenAPI 스키마 노출 여부. production에서는 이 줄이 없으면
# 자동으로 닫힙니다 (스키마는 전체 엔드포인트를 알려주는 공격 지도라서).
# ENABLE_DOCS=0

# 리버스 프록시(nginx/ALB) 뒤에 두면 1로 켜세요. 안 켜면 모든 요청의 IP가 프록시
# 주소로 보여서, IP 기준 상한이 **서비스 전체 상한**이 됩니다 (로그인 30/hour가
# 전 사용자 합쳐 시간당 30회). 반대로 프록시가 없는데 켜면 클라이언트가
# X-Forwarded-For를 지어내 상한을 통째로 우회할 수 있습니다.
# TRUST_PROXY_HEADERS=1

# rate limit 저장소. 비우면 프로세스 메모리라 **워커마다 따로 셉니다** —
# `uvicorn --workers 4`면 실제 상한이 4배가 됩니다. 워커를 늘릴 거면 Redis를 쓰세요.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# 요청 본문 상한(bytes). 기본 24MB — 가장 큰 정상 요청인 PDF 업로드(20MB)에 여유를 둔 값.
# MAX_REQUEST_BYTES=25165824

# ------------------------------------------------ 메일 발송 (비밀번호 재설정)
# SMTP_HOST와 SMTP_FROM이 **둘 다** 채워져야 실제로 발송합니다. 비어 있으면
# 개발 환경에서는 재설정 링크를 로그로 남기고, production에서는 503을 반환합니다
# (발송이 안 되는데 성공이라고 하면 사용자는 메일을 영영 못 받습니다).
#
# AWS SES를 쓴다면 (서울 리전 예시):
#   SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER / SMTP_PASSWORD  ← SES **SMTP 자격증명**. IAM 액세스 키와 다른 값이라
#                                 SES 콘솔에서 따로 발급받아야 합니다.
#   SMTP_FROM=noreply@도메인    ← SES에서 검증을 마친 주소여야 합니다.
# 지메일이나 Resend를 써도 이 네 값만 바꾸면 코드는 그대로입니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 재설정 링크의 앞부분 — 서버는 프론트가 어디 있는지 모르므로 알려줘야 합니다.
#   {FRONTEND_BASE_URL}/reset-password?token=...
FRONTEND_BASE_URL=http://localhost:5173

# 1이면 서버 기동 시 SPECTER2를 미리 로드합니다. 첫 분석이 빨라지는 대신 매 기동이
# 수십 초 느려집니다 — 로컬 개발에서는 꺼두세요. 배포 환경에서만 권장.
WARMUP_ON_STARTUP=0

# ---------------------------------------------------------------- 분석(LLM)
# 1이면 분석 시 실제 LLM 호출(Haiku 태깅 + Sonnet 종합), 0/미설정이면 스텁 응답($0).
# 기본은 off입니다. 켜기 전에 팀 예산을 먼저 확인하세요.
PAPER_ASSISTANT_USE_LLM=0

# 위를 1로 켤 때만 필요합니다 (anthropic SDK가 이 환경변수를 직접 읽습니다).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- 수집 배치
# 아래 셋은 **논문 코퍼스 재수집에만** 필요합니다. 코퍼스는 이미 적재돼 있으므로
# 서버를 띄우고 분석 API를 쓰는 데는 비워둬도 됩니다.

# OpenReview 계정 (https://openreview.net/signup 에서 무료 가입)
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Semantic Scholar API 키 (https://www.semanticscholar.org/product/api#api-key 무료 신청)
S2_API_KEY=
