# PostgreSQL 연결 정보 (본인 환경에 맞게 수정하세요)
DATABASE_URL=postgresql://username:password@localhost:5432/aice_db

# CORS 허용 프론트엔드 origin (JSON 배열 형식). 비워두면 코드 기본값(localhost:3000, 5173) 사용.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT 설정
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# OpenReview API (https://openreview.net 계정 필요, papers/reviews/revisions 수집용)
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
